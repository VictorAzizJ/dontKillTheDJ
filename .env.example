# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# PostgreSQL (Docker Compose defaults — see docker-compose.yml)
DATABASE_URL=postgresql://crowdcontrol:crowdcontrol@localhost:5432/crowdcontrol?schema=public

# Demo DJ login (used by prisma/seed.ts)
DEMO_DJ_EMAIL=dj@neonroom.local
DEMO_DJ_PASSWORD=crowdcontrol

# SMS — leave unset locally; missing keys must never fake a sent message.
# Point the Twilio number's "A message comes in" webhook at /api/twilio/sms (HTTP POST).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# Public URL Twilio signs, when it differs from the incoming request (tunnels).
# TWILIO_WEBHOOK_URL=
# Optional. Free-text SMS uses this model when set. Keywords and the local reader work without it.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
